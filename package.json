{
  "name": "openirl",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted tools for resilient IRL livestreaming",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
