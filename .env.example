# Copy to .env. Never commit real credentials.
OPENIRL_CONFIG_PATH=./config/openirl.yaml
OPENIRL_LOG_LEVEL=info

# MediaMTX control and metrics endpoints
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_METRICS_URL=http://mediamtx:9998

# OBS WebSocket
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=

# Required independently for dashboard mutations. Generate a different secret
# from the OBS password, for example: openssl rand -hex 32
OPENIRL_CONTROL_TOKEN=

# Dashboard-only MediaMTX HLS source. Keep this loopback-only on one host.
PREVIEW_UPSTREAM_URL=http://127.0.0.1:8888

# NOALBS
NOALBS_BASE_URL=http://noalbs:5000

# Reserved for the planned Twitch bot
TWITCH_CHANNEL=
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=

# Existing MediaMTX credential: sha256: plus base64 SHA256 digest, NOT the secret.
# Required by Compose. Preserve the value from the deployed config/stash.
FEED_1_PASSWORD_HASH=

# Exact OBS input name carrying Feed 1 audio; blank disables Mute/Unmute.
OBS_INGEST_AUDIO_SOURCE=

# Exact Feed 1 OBS Media Source (ffmpeg_source); blank disables Fix.
# May match the audio source, but must be configured independently.
OBS_INGEST_SOURCE=

# Optional HTTPS reverse proxy (docker/compose.https.yaml). Hostname only.
OPENIRL_DOMAIN=control.example.com
OPENIRL_AUTH_USER=operator
# Run caddy hash-password interactively; single quotes preserve literal $ in Compose.
# OPENIRL_AUTH_HASH='$2a$...your-generated-bcrypt-hash...'
OPENIRL_AUTH_HASH=

# Optional Cloudflare Tunnel (docker/compose.cloudflare.yaml).
# Sensitive connector token from Cloudflare's Docker installation command.
# Never commit/share it; rotate/revoke it if leaked. Access is configured separately.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional dynamic multi-ingest deployment: docker/compose.multi-ingest.yaml.
# Defaults remain on the existing single-feed stack until this overlay is used.
# DNS-only ingest host, separate from the Cloudflare-secured control hostname.
OPENIRL_INGEST_HOST=ingest.example.com
# Absolute directory containing server.crt (full chain) and server.key for ingest.
OPENIRL_INGEST_CERT_DIR=
# Only set openirl after disabling NOALBS bitrate scene switching. One scene owner.
OPENIRL_AUTOMATION_OWNER=noalbs
# Contribution listeners stay private until explicitly exposed. Keep internal
# API 9997, metrics 9998, dashboard 8080, auth 8081, OBS 4455 on loopback.
OPENIRL_RTMP_BIND=127.0.0.1:1935
OPENIRL_RTMPS_BIND=127.0.0.1:1936
OPENIRL_SRT_BIND=127.0.0.1:8890
# The overlay sets these internally; for running the dashboard without Docker:
# OPENIRL_MULTI_INGEST=true
# OPENIRL_REGISTRY_PATH=/absolute/private/registry.json
# OPENIRL_AUTH_PORT=8081
# OPENIRL_MEDIAMTX_API_URL=http://127.0.0.1:9997
# OPENIRL_MEDIAMTX_METRICS_URL=http://127.0.0.1:9998/metrics
# OPENIRL_SNAPSHOT_SOURCE=rtmp://127.0.0.1:1935
